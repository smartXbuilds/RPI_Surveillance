@page "/settings"
@implements IDisposable
@inject CameraSettingsStore Store
@inject INetworkService Network
@inject ImageStore Images
@inject ISystemTimeService Clock
@inject Microsoft.Extensions.Options.IOptions<RpiCamOptions> Options
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Locals.PageTitleSettings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@Locals.SettingsHeading</MudText>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsCamera</MudText>
    <MudStack Spacing="3">
        <MudSelect T="CameraSource" @bind-Value="_source" Label="@Locals.SettingsCameraSource" Variant="Variant.Outlined">
            <MudSelectItem T="CameraSource" Value="CameraSource.Pi">@Locals.CameraSourcePi</MudSelectItem>
            <MudSelectItem T="CameraSource" Value="CameraSource.Usb">@Locals.CameraSourceUsb</MudSelectItem>
            <MudSelectItem T="CameraSource" Value="CameraSource.Rtsp">@Locals.CameraSourceRtsp</MudSelectItem>
        </MudSelect>
        @if (_source == CameraSource.Usb)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudSelect T="string" @bind-Value="_usbDevice" Label="@Locals.SettingsUsbDevice" Variant="Variant.Outlined"
                           Disabled="_usbCameras.Count == 0" HelperText="@(_usbCameras.Count == 0 ? Locals.SettingsUsbNone : null)">
                    @foreach (var cam in _usbCameras)
                    {
                        <MudSelectItem T="string" Value="@cam.Device">@($"{cam.Name} ({cam.Device})")</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="FindUsbCameras" aria-label="@Locals.SettingsUsbRefresh" />
            </MudStack>
        }
        @if (_source == CameraSource.Rtsp)
        {
            <MudTextField T="string" @bind-Value="_rtspUrl" Label="@Locals.SettingsRtspUrl" HelperText="@Locals.SettingsRtspUrlHelp"
                          Placeholder="rtsp://192.168.1.50:554/stream1" Variant="Variant.Outlined" />
            <MudStack Row="true" Spacing="2">
                <MudTextField T="string" @bind-Value="_rtspUser" Label="@Locals.SettingsRtspUser" Variant="Variant.Outlined"
                              autocomplete="off" />
                <MudTextField T="string" @bind-Value="_rtspPassword" Label="@Locals.SettingsRtspPassword" Variant="Variant.Outlined"
                              InputType="InputType.Password" autocomplete="new-password"
                              HelperText="@(_rtspPasswordSet ? Locals.SettingsRtspPasswordKeep : null)" />
            </MudStack>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@SourceHint</MudText>
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveCameraAsync">@Locals.CommonSave</MudButton>
        </div>
    </MudStack>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsCapture</MudText>
    <MudStack Spacing="3">
        @if (Store.Current.Source == CameraSource.Rtsp)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@Locals.SettingsResolutionRtsp</MudAlert>
        }
        <MudNumericField T="int" @bind-Value="_interval" Label="@Locals.SettingsInterval"
                         HelperText="@Locals.SettingsIntervalHelp" Min="0" Variant="Variant.Outlined" />
        <MudSelect T="string" Value="ResolutionPreset" ValueChanged="SetResolutionPreset"
                   Label="@Locals.SettingsResolution" Variant="Variant.Outlined">
            @foreach (var preset in ResolutionPresets)
            {
                <MudSelectItem T="string" Value="@preset.Key">@preset.Label</MudSelectItem>
            }
            <MudSelectItem T="string" Value="@CustomResolutionKey">@Locals.SettingsResolutionCustom</MudSelectItem>
        </MudSelect>
        <MudStack Row="true" Spacing="2">
            <MudNumericField T="int" @bind-Value="_width" Label="@Locals.SettingsWidth"
                             Min="CameraSettings.MinSide" Max="CameraSettings.MaxSide" Variant="Variant.Outlined" />
            <MudNumericField T="int" @bind-Value="_height" Label="@Locals.SettingsHeight"
                             Min="CameraSettings.MinSide" Max="CameraSettings.MaxSide" Variant="Variant.Outlined" />
        </MudStack>
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsQuality: @_quality</MudText>
            <MudSlider T="int" @bind-Value="_quality" Min="10" Max="100" Color="Color.Primary" />
        </div>
    </MudStack>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsImageControls</MudText>
    <MudStack Spacing="3">
        @if (Store.Current.Source != CameraSource.Pi)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">@Locals.SettingsImageControlsPiOnly</MudAlert>
        }
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsBrightness: @_brightness.ToString("0.00")</MudText>
            <MudSlider T="double" @bind-Value="_brightness" Min="-1" Max="1" Step="0.05" Color="Color.Primary" />
        </div>
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsContrast: @_contrast.ToString("0.00")</MudText>
            <MudSlider T="double" @bind-Value="_contrast" Min="0" Max="2" Step="0.05" Color="Color.Primary" />
        </div>
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsSaturation: @_saturation.ToString("0.00")</MudText>
            <MudSlider T="double" @bind-Value="_saturation" Min="0" Max="2" Step="0.05" Color="Color.Primary" />
        </div>
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsSharpness: @_sharpness.ToString("0.00")</MudText>
            <MudSlider T="double" @bind-Value="_sharpness" Min="0" Max="2" Step="0.05" Color="Color.Primary" />
        </div>
        <div>
            <MudText Typo="Typo.body2">@Locals.SettingsEv: @_ev.ToString("0.0")</MudText>
            <MudSlider T="double" @bind-Value="_ev" Min="-2" Max="2" Step="0.1" Color="Color.Primary" />
        </div>
        <MudSelect T="AwbMode" @bind-Value="_awb" Label="@Locals.SettingsAwb" Variant="Variant.Outlined">
            @foreach (var mode in Enum.GetValues<AwbMode>())
            {
                <MudSelectItem T="AwbMode" Value="mode">@AwbLabel(mode)</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true" Spacing="4">
            <MudSwitch T="bool" @bind-Value="_hFlip" Color="Color.Primary" Label="@Locals.SettingsHFlip" />
            <MudSwitch T="bool" @bind-Value="_vFlip" Color="Color.Primary" Label="@Locals.SettingsVFlip" />
        </MudStack>
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync">@Locals.CommonSave</MudButton>
        </div>
    </MudStack>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsSavedNetworks</MudText>
    @if (_saved.Count == 0)
    {
        <MudText Class="mud-text-secondary">@Locals.SettingsNoSavedNetworks</MudText>
    }
    @foreach (var network in _saved)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Wifi" />
                <MudText>@network.Ssid</MudText>
                @if (network.Active)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@Locals.SettingsActive</MudChip>
                }
            </MudStack>
            <MudStack Row="true" Spacing="1">
                @if (!network.Active)
                {
                    <MudButton Variant="Variant.Outlined" Disabled="Network.Busy" OnClick="() => ConnectSaved(network)">
                        @Locals.CommonConnect
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           Disabled="Network.Busy" OnClick="() => RemoveAsync(network)">
                    @Locals.SettingsRemove
                </MudButton>
            </MudStack>
        </MudStack>
    }
    @if (_networkInfo is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">@_networkInfo</MudAlert>
    }
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsTime</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Locals.SettingsTimeHint</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
        <MudText>@Locals.SettingsTimeDevice: <b>@DateTime.Now.ToString("G")</b></MudText>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schedule" OnClick="SetTimeAsync">
            @Locals.SettingsTimeSet
        </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsStorage</MudText>
    <MudText>@string.Format(Locals.SettingsStorageInfo, Images.List().Count, Images.FreeMegabytes(), Options.Value.MinFreeMegabytes)</MudText>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-2">@Locals.SettingsLanguage</MudText>
    <CultureSelector />
</MudPaper>

@code {
    private const string CustomResolutionKey = "custom";

    // The OV5647's native sensor modes (confirmed via rpicam-hello --list-cameras on the device):
    // picking one of these avoids the camera cropping/scaling to an odd in-between resolution.
    private static readonly (string Key, int Width, int Height, string Label)[] ResolutionPresets =
    [
        ("640x480", 640, 480, "640 × 480"),
        ("1296x972", 1296, 972, "1296 × 972"),
        ("1920x1080", 1920, 1080, "1920 × 1080 (Full HD)"),
        ("2592x1944", 2592, 1944, "2592 × 1944 (max.)"),
    ];

    private int _interval;
    private int _width;
    private int _height;
    private int _quality;
    private double _brightness;
    private double _contrast;
    private double _saturation;
    private double _sharpness;
    private double _ev;
    private AwbMode _awb;
    private bool _hFlip;
    private bool _vFlip;
    private CameraSource _source;
    private string _usbDevice = "";
    private IReadOnlyList<UsbCamera> _usbCameras = [];
    private string _rtspUrl = "";
    private string _rtspUser = "";
    // Never sent to the browser: empty means "keep the stored password".
    private string _rtspPassword = "";
    private bool _rtspPasswordSet;
    private IReadOnlyList<SavedNetwork> _saved = [];
    private string? _networkInfo;

    protected override async Task OnInitializedAsync()
    {
        var current = Store.Current;
        (_interval, _width, _height, _quality) = (current.IntervalSeconds, current.Width, current.Height, current.Quality);
        (_brightness, _contrast, _saturation, _sharpness, _ev, _awb, _hFlip, _vFlip) =
            (current.Brightness, current.Contrast, current.Saturation, current.Sharpness, current.Ev, current.Awb, current.HFlip, current.VFlip);
        LoadCamera(current);
        FindUsbCameras();

        Network.Changed += OnNetworkChanged;
        await LoadSavedAsync();
    }

    private void LoadCamera(CameraSettings s)
    {
        (_source, _usbDevice, _rtspUrl, _rtspUser) = (s.Source, s.UsbDevice, s.RtspUrl, s.RtspUser);
        _rtspPassword = "";
        _rtspPasswordSet = s.RtspPassword.Length > 0;
    }

    private void FindUsbCameras()
    {
        _usbCameras = CameraInput.FindUsbCameras();
        // Preselect the only/first webcam, a common case with a single USB camera plugged in.
        if (_usbDevice.Length == 0 && _usbCameras.Count > 0)
        {
            _usbDevice = _usbCameras[0].Device;
        }
    }

    private string SourceHint => _source switch
    {
        CameraSource.Usb => Locals.SettingsSourceUsbHint,
        CameraSource.Rtsp => Locals.SettingsSourceRtspHint,
        _ => Locals.SettingsSourcePiHint,
    };

    private async Task SaveCameraAsync()
    {
        var url = _rtspUrl.Trim();
        if (_source == CameraSource.Usb && !CameraInput.IsValidUsbDevice(_usbDevice))
        {
            Snackbar.Add(Locals.SettingsUsbRequired, Severity.Error);
            return;
        }
        if (_source == CameraSource.Rtsp && !CameraInput.IsValidRtspUrl(url))
        {
            Snackbar.Add(Locals.SettingsRtspInvalid, Severity.Error);
            return;
        }
        var current = Store.Current;
        await Store.UpdateAsync(current with
        {
            Source = _source,
            UsbDevice = _source == CameraSource.Usb ? _usbDevice : current.UsbDevice,
            RtspUrl = _source == CameraSource.Rtsp ? url : current.RtspUrl,
            RtspUser = _source == CameraSource.Rtsp ? _rtspUser : current.RtspUser,
            RtspPassword = _source == CameraSource.Rtsp && _rtspPassword.Length > 0 ? _rtspPassword : current.RtspPassword,
        });
        LoadCamera(Store.Current);
        Snackbar.Add(Locals.SettingsSaved, Severity.Success);
    }

    private string ResolutionPreset =>
        ResolutionPresets.FirstOrDefault(p => p.Width == _width && p.Height == _height).Key ?? CustomResolutionKey;

    private void SetResolutionPreset(string key)
    {
        var preset = ResolutionPresets.FirstOrDefault(p => p.Key == key);
        if (preset.Key is not null)
        {
            (_width, _height) = (preset.Width, preset.Height);
        }
    }

    private static string AwbLabel(AwbMode mode) => mode switch
    {
        AwbMode.Auto => Locals.AwbAuto,
        AwbMode.Incandescent => Locals.AwbIncandescent,
        AwbMode.Tungsten => Locals.AwbTungsten,
        AwbMode.Fluorescent => Locals.AwbFluorescent,
        AwbMode.Indoor => Locals.AwbIndoor,
        AwbMode.Daylight => Locals.AwbDaylight,
        AwbMode.Cloudy => Locals.AwbCloudy,
        _ => mode.ToString(),
    };

    public void Dispose() => Network.Changed -= OnNetworkChanged;

    private void OnNetworkChanged() => _ = InvokeAsync(async () =>
    {
        if (!Network.Busy)
        {
            _networkInfo = null;
        }
        await LoadSavedAsync();
        StateHasChanged();
    });

    private async Task LoadSavedAsync()
    {
        try
        {
            _saved = await Network.GetSavedNetworksAsync();
        }
        catch (NetworkException ex)
        {
            _saved = [];
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        // "with": the camera source lives in the same settings and is saved by its own card.
        await Store.UpdateAsync(Store.Current with
        {
            IntervalSeconds = _interval, Width = _width, Height = _height, Quality = _quality,
            Brightness = _brightness, Contrast = _contrast, Saturation = _saturation, Sharpness = _sharpness,
            Ev = _ev, Awb = _awb, HFlip = _hFlip, VFlip = _vFlip,
        });
        // Show what was actually stored, the store clamps values to what the camera accepts.
        var saved = Store.Current;
        (_interval, _width, _height, _quality) = (saved.IntervalSeconds, saved.Width, saved.Height, saved.Quality);
        (_brightness, _contrast, _saturation, _sharpness, _ev, _awb, _hFlip, _vFlip) =
            (saved.Brightness, saved.Contrast, saved.Saturation, saved.Sharpness, saved.Ev, saved.Awb, saved.HFlip, saved.VFlip);
        Snackbar.Add(Locals.SettingsSaved, Severity.Success);
    }

    private void ConnectSaved(SavedNetwork network) => Report(Network.BeginConnectSaved(network.Uuid), Locals.WifiSwitchInfo);

    private async Task RemoveAsync(SavedNetwork network)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Locals.SettingsRemoveTitle,
            string.Format(Locals.SettingsRemoveConfirm, network.Ssid),
            yesText: Locals.SettingsRemove,
            cancelText: Locals.CommonCancel);
        if (confirmed == true)
        {
            Report(Network.BeginRemove(network.Uuid), Locals.WifiHotspotInfo);
        }
    }

    private void Report(RequestResult result, string acceptedInfo)
    {
        if (result == RequestResult.Accepted)
        {
            _networkInfo = string.Format(acceptedInfo, Environment.MachineName.ToLowerInvariant());
        }
        else
        {
            Snackbar.Add(Locals.WifiBusy, Severity.Warning);
        }
    }

    private async Task SetTimeAsync()
    {
        var milliseconds = await JS.InvokeAsync<long>("Date.now");
        var ok = await Clock.SetAsync(DateTimeOffset.FromUnixTimeMilliseconds(milliseconds));
        Snackbar.Add(ok ? Locals.SettingsTimeDone : Locals.SettingsTimeFailed, ok ? Severity.Success : Severity.Error);
    }
}
