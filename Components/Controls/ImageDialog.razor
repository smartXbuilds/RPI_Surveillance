@inject ImageStore Images
@inject ClipStore Clips
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (IsClip)
        {
            <video src="/api/motion/clips/@Name" controls preload="metadata"
                   style="display:block; max-width:100%; max-height:70vh; margin:0 auto;"></video>
        }
        else
        {
            <img src="/api/images/@Name" alt="@Name" style="display:block; max-width:100%; max-height:70vh; margin:0 auto;" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Download" Href="@DownloadUrl" download="@Name">
            @Locals.CommonDownload
        </MudButton>
        <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">
            @Locals.CommonDelete
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Close()">@Locals.CommonClose</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    private bool IsClip => ClipStore.IsValidName(Name);

    private string DownloadUrl => IsClip ? $"/api/motion/clips/{Name}?download=true" : $"/api/images/{Name}?download=true";

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Locals.GalleryDeleteTitle,
            string.Format(Locals.GalleryDeleteConfirm, 1),
            yesText: Locals.CommonDelete,
            cancelText: Locals.CommonCancel);
        if (confirmed != true)
        {
            return;
        }
        Snackbar.Add(string.Format(Locals.GalleryDeleted, (IsClip ? (Clips.Delete(Name) ? 1 : 0) : Images.Delete([Name]))), Severity.Success);
        MudDialog.Close();
    }
}
