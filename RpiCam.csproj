<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Target is a Pi 3A+ with 512 MB RAM: workstation GC without a background thread keeps the heap small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Publish output and runtime data live inside the project folder but are not part of the project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;data/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development settings (simulation mode, dev login) must never end up on the device. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.1" />
  </ItemGroup>

</Project>
